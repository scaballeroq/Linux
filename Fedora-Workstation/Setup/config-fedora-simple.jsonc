{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // =========================================================================
    //  Fedora 45 Workstation (GNOME Wayland) - Simple Clean Theme
    // =========================================================================
    "logo": {
        "type": "small",
        "source": "fedora",
        "color": {
            "1": "38;2;60;110;180",
            "2": "38;2;255;255;255"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " -> ",
        "color": {
            "keys": "38;2;60;110;180",
            "title": "1;38;2;60;110;180"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " OS      "
        },
        {
            "type": "host",
            "key": "󰌢 Host    "
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel  "
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime  "
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        {
            "type": "shell",
            "key": "󰞷 Shell   "
        },
        {
            "type": "de",
            "key": "󰕮 DE      "
        },
        {
            "type": "wm",
            "key": "󱂬 WM      "
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU     "
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU     "
        },
        {
            "type": "memory",
            "key": "󰑭 Memory  "
        },
        {
            "type": "swap",
            "key": "󰓡 ZRAM    "
        },
        {
            "type": "disk",
            "key": "󰋊 Disk    "
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
