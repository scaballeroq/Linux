{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // =========================================================================
    //  Fedora 45 Workstation (GNOME Wayland) - Categorized Hero Theme
    //  Color Primario: Fedora Official Blue (RGB: 60, 110, 180 -> 38;2;60;110;180)
    // =========================================================================
    "logo": {
        "type": "small",
        "source": "fedora",
        "color": {
            "1": "38;2;60;110;180",
            "2": "38;2;255;255;255"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;60;110;180",
            "title": "1;38;2;60;110;180"
        },
        "key": {
            "width": 16
        },
        "bar": {
            "char": {
                "elapsed": "■",
                "total": "･"
            },
            "width": 14,
            "border": {
                "left": "[",
                "right": "]"
            }
        },
        "percent": {
            "type": 3
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "custom",
            "format": "\u001b[1;38;2;60;110;180m┌────────────────── HARDWARE ──────────────────┐\u001b[0m"
        },
        {
            "type": "host",
            "key": "  󰌢 Equipo"
        },
        {
            "type": "cpu",
            "key": "  󰻠 CPU",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "  󰢮 GPU"
        },
        {
            "type": "display",
            "key": "  󰍹 Pantalla",
            "compactType": "original-with-refresh-rate"
        },
        {
            "type": "memory",
            "key": "  󰑭 Memoria RAM"
        },
        {
            "type": "swap",
            "key": "  󰓡 Swap (ZRAM)"
        },
        {
            "type": "disk",
            "key": "  󰋊 Disco (/)"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;60;110;180m├─────────────────── SYSTEM ───────────────────┤\u001b[0m"
        },
        {
            "type": "os",
            "key": "   Sistema"
        },
        {
            "type": "kernel",
            "key": "  󰌽 Kernel"
        },
        {
            "type": "packages",
            "key": "  󰏖 Paquetes"
        },
        {
            "type": "uptime",
            "key": "  󰅐 Uptime"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;60;110;180m├───────────── THEMING & DESKTOP ──────────────┤\u001b[0m"
        },
        {
            "type": "de",
            "key": "  󰕮 Escritorio"
        },
        {
            "type": "wm",
            "key": "  󱂬 Compositor"
        },
        {
            "type": "theme",
            "key": "  󰉼 Tema GTK"
        },
        {
            "type": "icons",
            "key": "  󰀻 Iconos"
        },
        {
            "type": "cursor",
            "key": "  󰇀 Cursor"
        },
        {
            "type": "terminal",
            "key": "  󰆍 Terminal"
        },
        {
            "type": "terminalfont",
            "key": "  󰛖 Fuente"
        },
        {
            "type": "shell",
            "key": "  󰞷 Shell"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;60;110;180m└──────────────────────────────────────────────┘\u001b[0m"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}