# =============================================================================
# Fedora Workstation Environment Configuration Justfile
# (Fedora Workstation + GNOME Shell Wayland)
# =============================================================================

# Instala todo el entorno por defecto (Auto-detección de CPU / Portátil AMD)
setup-all: post-install multimedia flatpak chrome steam laptop tuning gnome-setup shell security fonts fastfetch kitty yt-dlp virtualization cockpit ides git-setup languages podman-setup
    @echo "🚀 Entorno completo de Fedora Workstation (GNOME Shell Wayland) configurado. Por favor, reinicia el sistema."

# Perfil completo para Portátil de desarrollo (AMD Ryzen + Virtualización + Contenedores)
setup-laptop-amd: post-install-amd multimedia flatpak chrome steam laptop tuning gnome-setup shell security fonts fastfetch kitty yt-dlp virtualization cockpit ides git-setup languages podman-setup
    @echo "🚀 Entorno Portátil AMD Ryzen (GNOME Shell) configurado con éxito. Por favor, reinicia el sistema."

# Perfil para Sobremesa Centro Multimedia (Intel Core / Media Center - Sin virtualización ni batería)
setup-media-desktop: post-install-intel multimedia chrome tuning gnome-setup shell security fonts fastfetch kitty yt-dlp kodi
    @echo "🚀 Entorno Sobremesa Intel (GNOME Shell) configurado con éxito. Por favor, reinicia el sistema."

# =============================================================================
# CONFIGURACIÓN BASE DEL SISTEMA
# =============================================================================

# Configuración base post-instalación (Auto-detección inteligente: AMD Ryzen vs Intel Core)
post-install:
    ./Setup/post-install.sh

# Configuración post-instalación para AMD Ryzen (Kernel, Mesa RADV, VA-API freeworld, PipeWire, Flatpak, GNOME Shell, ZRAM)
post-install-amd:
    ./Setup/post-install-amd.sh

# Configuración post-instalación para Intel Haswell/Core (Microcódigo Intel, VA-API Intel, Kodi, PipeWire, GNOME Shell)
post-install-intel:
    ./Setup/post-install-intel.sh

# Optimización para portátiles de desarrollo (tuned-ppd, Bluetooth FastConnectable, cierre de tapa con multimonitor, Touchpad Wayland y Mutter VRR)
laptop:
    ./Setup/laptop-setup.sh

# Estado y diagnóstico del hardware del portátil
laptop-status:
    ./Setup/laptop-setup.sh --status

# Autenticación y desbloqueo por huella dactilar (fprintd, authselect PAM)
fingerprint *args:
    ./Setup/fingerprint-setup.sh {{args}}

# Estado y diagnóstico de la autenticación por huella dactilar
fingerprint-status:
    ./Setup/fingerprint-setup.sh --status

# Registrar huella dactilar en la terminal (sensor biométrico)
fingerprint-enroll *finger:
    ./Setup/fingerprint-setup.sh --enroll {{finger}}

# Probar verificación biométrica en el lector
fingerprint-verify:
    ./Setup/fingerprint-setup.sh --verify

# Configuración de impresoras HP (CUPS, HPLIP, plugin propietario para LaserJet M15w)
printer:
    ./Setup/hp-printer-setup.sh

# Estado del sistema de impresión HP
printer-status:
    ./Setup/hp-printer-setup.sh --status

# Personalización y configuración de GNOME Shell (Modo oscuro, botones de ventana, scripts de Nautilus, atajos)
gnome-setup:
    ./Setup/gnome-settings.sh

# Aplicar tema oscuro completo en GNOME Shell (prefer-dark + adw-gtk3-dark)
gnome-theme-dark:
    ./Setup/gnome-settings.sh --dark

# Aplicar tema claro completo en GNOME Shell (prefer-light)
gnome-theme-light:
    ./Setup/gnome-settings.sh --light

# Diagnóstico y estado de la configuración de GNOME Shell
gnome-status:
    ./Setup/gnome-settings.sh --status

# Gestión e inspección de extensiones de GNOME Shell
gnome-extensions *args:
    ./Setup/gnome-extensions.sh {{args}}

# Diagnóstico del estado de extensiones de GNOME Shell
gnome-extensions-status:
    ./Setup/gnome-extensions.sh --status

# Gestión de apariencia, temas de iconos (Papirus/Adwaita) y cursores (Bibata)
apariencia *args:
    ./Setup/apariencia.sh {{args}}

# Diagnóstico del estado de apariencia y temas
apariencia-status:
    ./Setup/apariencia.sh --status

# Optimizaciones avanzadas de rendimiento (Sysctl, límites, inotify 1M, max_map_count 16M, TCP BBR, ZRAM, exclusiones Tracker)
tuning:
    ./Setup/fedora-tuning.sh

# Estado actual de las optimizaciones y métricas de rendimiento
tuning-status:
    ./Setup/fedora-tuning.sh --status

# Utilidades de terminal modernas (eza, bat, fzf, zoxide, ripgrep, fd, duf, dust, btop)
shell:
    ./Setup/shell.sh

# Diagnóstico y estado de utilidades CLI de terminal (eza, bat, fzf, zoxide, ripgrep...)
shell-status:
    ./Setup/shell.sh --status

# Starship Prompt moderno (Instalar / Activar)
starship:
    ./Setup/starship.sh --enable

# Desactivar Starship y restaurar prompt nativo
starship-disable:
    ./Setup/starship.sh --disable

# Estado de Starship prompt
starship-status:
    ./Setup/starship.sh --status

# Seguridad y cortafuegos obligatorio (Firewalld con servicios gsconnect/kdeconnect, mdns, ssh, KVM virbr0, Podman rootless, Sysctl)
security:
    ./Setup/seguridad.sh

# Estado y diagnóstico de seguridad, cortafuegos Firewalld y sysctl
security-status:
    ./Setup/seguridad.sh --status

# Integración de GSConnect (KDE Connect para GNOME) y reglas de Firewalld (1714-1764 TCP/UDP)
gsconnect *args:
    ./Setup/gsconnect.sh {{args}}

# Estado y diagnóstico de GSConnect, reglas de red y dispositivos emparejados
gsconnect-status:
    ./Setup/gsconnect.sh --status

# Fuentes de desarrollo (Nerd Fonts: JetBrainsMono, FiraCode, CascadiaCode, Meslo, Hack)
fonts:
    ./Setup/fonts.sh

# Estado y diagnóstico de fuentes de desarrollo (Nerd Fonts)
fonts-status:
    ./Setup/fonts.sh --status

# Información estética del sistema (Fastfetch)
fastfetch *args:
    ./Setup/fastfetch.sh {{args}}

# Estado y diagnóstico de la configuración de Fastfetch
fastfetch-status:
    ./Setup/fastfetch.sh --status

# Terminal Kitty acelerada por GPU con tema Catppuccin Mocha, opacidad/blur y atajo Ctrl+Alt+T
kitty:
    ./Setup/kitty.sh

# Estado y diagnóstico de Kitty Terminal
kitty-status:
    ./Setup/kitty.sh --status

# Multimedia (yt-dlp stack, FFmpeg, aria2, motor JS Deno vía Mise)
yt-dlp *args:
    ./Setup/yt-dlp-setup.sh {{args}}

# Diagnóstico y estado de yt-dlp y herramientas multimedia
yt-dlp-status:
    ./Setup/yt-dlp-setup.sh --status

# Limpieza de caché residual de yt-dlp
yt-dlp-clean-cache:
    ./Setup/yt-dlp-setup.sh --clean-cache

# Suite multimedia completa (RPM Fusion Free/Nonfree/Tainted, FFmpeg completo, GStreamer, VA-API freeworld, Celluloid, MPV, VLC)
multimedia:
    ./Setup/multimedia.sh

# Estado de repositorios multimedia, códecs y aceleración VA-API
multimedia-status:
    ./Setup/multimedia.sh --status

# Aplicaciones y herramientas desacopladas vía Flatpak (Flatseal, Podman Desktop, Warehouse, VLC...)
flatpak *args:
    ./Setup/flatpak.sh {{args}}

# Diagnóstico y estado de Flatpak, repositorio Flathub y aplicaciones instaladas
flatpak-status:
    ./Setup/flatpak.sh --status

# Actualizar todas las aplicaciones y runtimes de Flatpak
flatpak-update:
    ./Setup/flatpak.sh --update

# Limpiar runtimes huérfanos y dependencias no utilizadas de Flatpak
flatpak-clean:
    ./Setup/flatpak.sh --clean

# Navegador Google Chrome oficial (Instalación, actualización u optimización Wayland)
chrome *args:
    ./Setup/chrome.sh {{args}}

# Diagnóstico y estado de Google Chrome, repositorio oficial y Wayland
chrome-status:
    ./Setup/chrome.sh --status

# Navegador Mozilla Firefox nativo con aceleración por hardware
firefox:
    ./Setup/firefox.sh

# Diagnóstico y estado de Mozilla Firefox
firefox-status:
    ./Setup/firefox.sh --status

# Steam nativo (RPM Fusion Non-Free), GameMode, MangoHud y drivers Vulkan 32-bit (i686)
steam:
    ./Setup/steam.sh

# Diagnóstico y estado de Steam y herramientas de Gaming
steam-status:
    ./Setup/steam.sh --status

# Centro Multimedia (Kodi + complementos de streaming)
kodi:
    command -v dnf5 &>/dev/null && sudo dnf5 install -y kodi kodi-inputstream-adaptive kodi-inputstream-rtmp || sudo dnf install -y kodi kodi-inputstream-adaptive kodi-inputstream-rtmp

# Actualización completa del sistema Fedora vía DNF/DNF5
update:
    command -v dnf5 &>/dev/null && sudo dnf5 upgrade --refresh -y && sudo dnf5 autoremove -y && sudo dnf5 clean all || sudo dnf upgrade --refresh -y && sudo dnf autoremove -y && sudo dnf clean all

