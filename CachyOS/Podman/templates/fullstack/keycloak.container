[Unit]
Description=Keycloak for __PROJECT__
Requires=network-online.target
After=network-online.target __PROJECT__-postgres.service

[Container]
ContainerName=__PROJECT__-keycloak
Image=quay.io/keycloak/keycloak:latest
EnvironmentFile=%h/Workspace/Repositorios/Linux/Podman/projects/__PROJECT__/.env
Environment=KEYCLOAK_ADMIN=${KEYCLOAK_ADMIN:-admin}
Environment=KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD:-admin}
Environment=KC_DB=postgres
Environment=KC_DB_URL=jdbc:postgresql://__PROJECT__-postgres:5432/keycloak
Environment=KC_DB_USERNAME=${POSTGRES_USER:-postgres}
Environment=KC_DB_PASSWORD=${POSTGRES_PASSWORD:-changeme}
Environment=KC_HOSTNAME=localhost
PublishPort=8080:8080
Network=__PROJECT__.network

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=__PROJECT__.target
