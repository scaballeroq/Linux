// Fastfetch Ubuntu Theme Configuration
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "ubuntu",
        "type": "auto",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "  ➜  ",
        "color": {
            "keys": "38;2;233;84;32",
            "title": "38;2;119;41;83"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "de",
            "key": "DE",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "swap",
            "key": "Swap (ZRAM)",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "disk",
            "key": "Disk (/)",
            "keyColor": "38;2;233;84;32"
        },
        {
            "type": "localip",
            "key": "Local IP",
            "keyColor": "38;2;233;84;32"
        },
        "break",
        "colors"
    ]
}
