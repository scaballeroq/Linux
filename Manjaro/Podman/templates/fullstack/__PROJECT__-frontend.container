[Unit]
Description=Frontend para __PROJECT__
After=__PROJECT__.network

[Container]
ContainerName=__PROJECT__-frontend
Image=docker.io/library/node:22-alpine
EnvironmentFile=__PROJECT_DIR__/.env
Network=__PROJECT__.network
Volume=__PROJECT_DIR__/frontend:/app:z
WorkingDir=/app
Command=sh -c "npm install && npm run dev -- --host 0.0.0.0 --port 3000"
Label=traefik.enable=true
Label=traefik.http.routers.__PROJECT__-frontend.rule=Host(`app.__PROJECT__.localhost`)
Label=traefik.http.routers.__PROJECT__-frontend.entrypoints=web
Label=traefik.http.routers.__PROJECT__-frontend.service=__PROJECT__-frontend
Label=traefik.http.services.__PROJECT__-frontend.loadbalancer.server.port=3000
PublishPort=3000:3000
HealthCmd=curl -sf http://localhost:3000 || exit 1
HealthStartPeriod=30s
HealthInterval=10s
HealthRetries=3
HealthTimeout=5s

[Install]
WantedBy=__PROJECT__.target
