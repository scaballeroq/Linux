//          /_/                                     
// openSUSE Tumbleweed - Geeko Chameleon Hero Theme
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "opensuse",
        "type": "builtin",
        "color": {
            "1": "green",
            "2": "white"
        },
        "padding": {
            "top": 0,
            "right": 3
        }
    },
    "display": {
        "separator": "  ➜  ",
        "color": {
            "separator": "green"
        },
        "key": {
            "width": 15
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#1}{#32} {#37}{user-name}{#32}@{#36}{host-name}{#0}"
        },
        {
            "type": "custom",
            "format": "{#32}──────────────────────────────────────────{#0}"
        },
        {
            "type": "host",
            "key": "󰍹 Host",
            "keyColor": "green"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "green"
        },
        {
            "type": "de",
            "key": "󰇄 Desktop",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "󰧨 Window Mgr",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": " Memory",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "󰉉 Disk",
            "keyColor": "magenta",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "{#32}──────────────────────────────────────────{#0}"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}