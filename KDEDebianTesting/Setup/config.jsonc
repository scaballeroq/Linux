// Debian Testing (Trixie/Sid) - KDE Plasma 6 Wayland Hero Theme
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "debian",
        "type": "builtin",
        "color": {
            "1": "red",
            "2": "white"
        },
        "padding": {
            "top": 0,
            "right": 3
        }
    },
    "display": {
        "separator": "  ➜  ",
        "color": {
            "separator": "red"
        },
        "key": {
            "width": 15
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#1}{#31} {#37}{user-name}{#31}@{#36}{host-name}{#0}"
        },
        {
            "type": "custom",
            "format": "{#31}──────────────────────────────────────────{#0}"
        },
        {
            "type": "host",
            "key": "󰍹 Host",
            "keyColor": "red"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "red"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "red"
        },
        {
            "type": "de",
            "key": "󰇄 Desktop",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "󰧨 Window Mgr",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": " Memory",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "󰉉 Disk (/)",
            "keyColor": "magenta",
            "folders": "/"
        },
        {
            "type": "localip",
            "key": "󰩟 Network",
            "keyColor": "blue",
            "showIpv4": true,
            "showPrefixLen": false
        },
        {
            "type": "break"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
