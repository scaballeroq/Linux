# =============================================================================
# Soplos Linux Boro Environment Configuration Justfile
# (Soplos Linux Boro Workstation + GNOME Shell Wayland)
# =============================================================================

# Instala todo el entorno por defecto (Auto-detección de CPU / Portátil AMD)
setup-all: post-install multimedia flatpak chrome steam laptop tuning gnome-setup shell security fonts fastfetch yt-dlp virtualization cockpit ides git-setup languages podman-setup
    @echo "🚀 Entorno completo de Soplos Linux Boro (GNOME Shell Wayland) configurado. Por favor, reinicia el sistema."

# Perfil completo para Portátil de desarrollo (AMD Ryzen + Virtualización + Contenedores)
setup-laptop-amd: post-install-amd multimedia flatpak chrome steam laptop tuning gnome-setup shell security fonts fastfetch yt-dlp virtualization cockpit ides git-setup languages podman-setup
    @echo "🚀 Entorno Portátil AMD Ryzen (GNOME Shell) configurado con éxito. Por favor, reinicia el sistema."

# Perfil para Sobremesa Centro Multimedia (Intel Core / Media Center - Sin virtualización ni batería)
setup-media-desktop: post-install-intel multimedia chrome tuning gnome-setup shell security fonts fastfetch yt-dlp kodi
    @echo "🚀 Entorno Sobremesa Intel (GNOME Shell) configurado con éxito. Por favor, reinicia el sistema."

# =============================================================================
# CONFIGURACIÓN BASE DEL SISTEMA
# =============================================================================

# Configuración base post-instalación (Auto-detección inteligente: AMD Ryzen vs Intel Core)
post-install:
    ./Setup/post-install.sh

# Configuración post-instalación para AMD Ryzen (Kernel, firmware AMD, Mesa RADV, VA-API, PipeWire, Flatpak, GNOME Shell, ZRAM)
post-install-amd:
    ./Setup/post-install-amd.sh

# Configuración post-instalación para Intel Haswell/Core (Microcódigo Intel, i965/iHD VA-API, Kodi, PipeWire, GNOME Shell)
post-install-intel:
    ./Setup/post-install-intel.sh

# Optimización para portátiles de desarrollo (power-profiles-daemon, Bluetooth FastConnectable, cierre de tapa con multimonitor, Touchpad Wayland y Mutter VRR)
laptop:
    ./Setup/laptop-setup.sh

# Estado y diagnóstico de la configuración del portátil
laptop-status:
    ./Setup/laptop-setup.sh --status

# Autenticación y desbloqueo por huella dactilar (fprintd, PAM)
fingerprint *args:
    ./Setup/fingerprint-setup.sh {{args}}

# Estado y diagnóstico de la autenticación por huella dactilar
fingerprint-status:
    ./Setup/fingerprint-setup.sh --status

# Registrar huella dactilar en la terminal (sensor táctil)
fingerprint-enroll *finger:
    ./Setup/fingerprint-setup.sh --enroll {{finger}}

# Probar verificación biométrica en el lector
fingerprint-verify *finger:
    ./Setup/fingerprint-setup.sh --verify {{finger}}

# Configuración de impresoras HP (CUPS, HPLIP, plugin propietario para LaserJet M15w)
printer:
    ./Setup/hp-printer-setup.sh

# Estado y diagnóstico del sistema de impresión HP
printer-status:
    ./Setup/hp-printer-setup.sh --status

# Instalar o actualizar el plugin propietario oficial de HP (firmware LaserJet M15w)
printer-plugin:
    ./Setup/hp-printer-setup.sh --plugin

# Configurar impresora HP en red local / Wi-Fi
printer-wifi:
    ./Setup/hp-printer-setup.sh --wifi

# Configurar impresora HP conectada por cable USB
printer-usb:
    ./Setup/hp-printer-setup.sh --usb

# Abrir panel gráfico de impresoras en GNOME
printer-gui:
    ./Setup/hp-printer-setup.sh --gui

# Enviar página de prueba a la impresora predeterminada
printer-test:
    ./Setup/hp-printer-setup.sh --test

# Personalización y configuración de GNOME Shell (Modo oscuro, botones de ventana, scripts de Nautilus, atajos)
gnome-setup:
    ./Setup/gnome-settings.sh

# Aplicar tema oscuro oficial de Soplos Linux Boro (Orchis-Orange-Dark + kora-soplos)
gnome-theme-dark:
    ./Setup/gnome-settings.sh --dark

# Aplicar tema claro oficial de Soplos Linux Boro (Orchis-Orange-Light + kora-soplos)
gnome-theme-light:
    ./Setup/gnome-settings.sh --light

# Diagnóstico y estado de la configuración de GNOME Shell
gnome-status:
    ./Setup/gnome-settings.sh --status

# Gestión e inspección de extensiones de GNOME Shell
gnome-extensions *args:
    ./Setup/gnome-extensions.sh {{args}}

# Diagnóstico del estado de extensiones de GNOME Shell
gnome-extensions-status:
    ./Setup/gnome-extensions.sh --status

# Gestión de apariencia, temas de iconos (Papirus/Adwaita) y cursores (Bibata)
apariencia *args:
    ./Setup/apariencia.sh {{args}}

# Diagnóstico del estado de apariencia y temas
apariencia-status:
    ./Setup/apariencia.sh --status

# Optimizaciones avanzadas de rendimiento (Sysctl, límites, inotify 1M, max_map_count 16M, TCP BBR, exclusiones Tracker)
tuning:
    ./Setup/soplos-tuning.sh

# Estado actual de las optimizaciones y métricas de rendimiento
tuning-status:
    ./Setup/soplos-tuning.sh --status

# Utilidades de terminal modernas (eza, bat, fzf, zoxide, ripgrep, fd, duf, dust, btop)
shell:
    ./Setup/shell.sh

# Diagnóstico y estado de utilidades CLI de terminal (eza, bat, fzf, zoxide, ripgrep...)
shell-status:
    ./Setup/shell.sh --status

# Starship Prompt moderno (Instalar / Activar)
starship:
    ./Setup/starship.sh --enable

# Desactivar Starship y restaurar prompt nativo
starship-disable:
    ./Setup/starship.sh --disable

# Estado de Starship prompt
starship-status:
    ./Setup/starship.sh --status

# Suite de Fuentes Nerd Fonts completas (JetBrainsMono, FiraCode, CascadiaCode, Meslo, Hack)
fonts *args:
    ./Setup/fonts.sh {{args}}

# Diagnóstico y listado de fuentes Nerd Fonts instaladas
fonts-status:
    ./Setup/fonts.sh --status

# Diagnóstico visual del sistema (Fastfetch con diseño Soplos Linux Boro y soporte FastCat)
fastfetch *args:
    ./Setup/fastfetch.sh {{args}}

# Estado del tema de Fastfetch
fastfetch-status:
    ./Setup/fastfetch.sh --status

# Diagnóstico y estado de la terminal Ghostty preinstalada
ghostty-status:
    @echo "================================================================="
    @echo "🔍 ESTADO DE GHOSTTY TERMINAL - SOPLOS LINUX BORO"
    @echo "================================================================="
    @echo "• Binario Ghostty:  $$(if command -v ghostty &>/dev/null; then echo "✅ Presente ($$(ghostty --version 2>/dev/null | head -n1))"; else echo "❌ No encontrado"; fi)"
    @echo "• Configuración:    $$(if [ -f "$$HOME/.config/ghostty/config" ]; then echo "✅ Presente ($$HOME/.config/ghostty/config)"; else echo "❌ No presente"; fi)"
    @echo "• Atajo GNOME:      $$(if gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null | grep -qi "custom0"; then echo "✅ Asignado Ctrl+Alt+T"; else echo "❌ No asignado"; fi)"
    @echo "================================================================="

# Descargador y stack multimedia yt-dlp + FFmpeg + Deno JS engine
