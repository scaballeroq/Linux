{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/branding-soplos/menusoplos.png",
        "type": "auto",
        "height": 18,
        "width": 32,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰅂 ",
        "color": {
            "keys": "38;2;255;203;65",
            "title": "38;2;242;83;54",
            "separator": "38;2;237;152;45"
        },
        "percent": {
            "type": 3
        },
        "bar": {
            "char": {
                "elapsed": "■",
                "total": "─"
            },
            "width": 10
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "\u001b[38;2;242;83;54m────────────────────────────────────────────────────────\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[1;38;2;242;83;54m󰋊 HARDWARE\u001b[0m"
        },
        {
            "type": "host",
            "key": "  󰌢 Host      "
        },
        {
            "type": "cpu",
            "key": "  󰻠 CPU       ",
            "format": "{1} ({3}) @ {7}"
        },
        {
            "type": "gpu",
            "key": "  󰢮 GPU       ",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "  󰍛 Memory    "
        },
        {
            "type": "disk",
            "key": "  󰋊 Disk      ",
            "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage}) [{mountpoint}] - {filesystem}"
        },
        {
            "type": "battery",
            "key": "   Battery   "
        },
        {
            "type": "display",
            "key": "  󰍹 Display   "
        },
        {
            "type": "sound",
            "key": "   Audio     ",
            "format": "{name:-25} {volume-percentage-bar} ({volume-percentage})"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;38;2;242;83;54m󰻠 SYSTEM\u001b[0m"
        },
        {
            "type": "os",
            "key": "   OS        ",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "   Kernel    "
        },
        {
            "type": "packages",
            "key": "  󰏖 Packages  "
        },
        {
            "type": "uptime",
            "key": "  󰅐 Uptime    "
        },
        {
            "type": "command",
            "key": "  󰚭 OS Age    ",
            "text": "birth_install=$(stat -c %W / 2>/dev/null || echo 0); current=$(date +%s); if [ \"$birth_install\" -gt 0 ]; then echo \"$(( (current - birth_install) / 86400 )) days\"; else echo 'Unknown'; fi"
        },
        {
            "type": "locale",
            "key": "   Locale    "
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;38;2;242;83;54m󰔎 THEMING & DESKTOP\u001b[0m"
        },
        {
            "type": "de",
            "key": "   Desktop   "
        },
        {
            "type": "wm",
            "key": "   WM        "
        },
        {
            "type": "theme",
            "key": "  󰉼 Theme     "
        },
        {
            "type": "icons",
            "key": "  󰸉 Icons     "
        },
        {
            "type": "font",
            "key": "   Font      "
        },
        {
            "type": "terminal",
            "key": "   Terminal  "
        },
        {
            "type": "shell",
            "key": "   Shell     "
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
