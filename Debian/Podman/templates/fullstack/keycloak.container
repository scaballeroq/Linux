[Unit]
Description=Keycloak Auth para __PROJECT__
After=__PROJECT__.network __PROJECT__-postgres.service
Requires=__PROJECT__-postgres.service

[Container]
ContainerName=__PROJECT__-keycloak
Image=quay.io/keycloak/keycloak:26
EnvironmentFile=__PROJECT_DIR__/.env
Network=__PROJECT__.network
PublishPort=8083:8080
Command=start-dev --http-relative-path=/auth
Label=traefik.enable=true
Label=traefik.http.routers.__PROJECT__-keycloak.rule=Host(`auth.__PROJECT__.localhost`)
Label=traefik.http.routers.__PROJECT__-keycloak.entrypoints=web
Label=traefik.http.routers.__PROJECT__-keycloak.service=__PROJECT__-keycloak
Label=traefik.http.services.__PROJECT__-keycloak.loadbalancer.server.port=8080
HealthCmd=curl -sf http://localhost:8080/auth/health/ready || exit 1
HealthStartPeriod=60s
HealthInterval=10s
HealthRetries=10
HealthTimeout=5s

[Install]
WantedBy=__PROJECT__.target
