[Unit]
Description=PostgreSQL para __PROJECT__
After=__PROJECT__.network

[Container]
ContainerName=__PROJECT__-postgres
Image=docker.io/library/postgres:17-alpine
EnvironmentFile=%h/.config/containers/systemd/__PROJECT__/.env
Network=__PROJECT__.network
Volume=__PROJECT__-pg-data:/var/lib/postgresql/data
PublishPort=5432:5432
HealthCmd=pg_isready -U $${POSTGRES_USER:-postgres} -d $${POSTGRES_DB:-__PROJECT__}
HealthStartPeriod=10s
HealthInterval=5s
HealthRetries=5
HealthTimeout=5s
UidMap=0:0:1
UidMap=1:100000:65536
GidMap=0:0:1
GidMap=1:100000:65536

[Volume]
VolumeName=__PROJECT__-pg-data

[Install]
WantedBy=__PROJECT__.target
