[Unit]
Description=Backend Python para __PROJECT__
After=__PROJECT__.network __PROJECT__-postgres.service
Requires=__PROJECT__-postgres.service

[Container]
ContainerName=__PROJECT__-backend
Image=docker.io/library/python:3.13-slim
EnvironmentFile=%h/.config/containers/systemd/__PROJECT__/.env
Network=__PROJECT__.network
Volume=$PROJECT_DIR/src:/app:z
Volume=$PROJECT_DIR/requirements.txt:/app/requirements.txt:ro,z
WorkingDir=/app
Command=sh -c "pip install --no-cache-dir -r requirements.txt && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
PublishPort=8000:8000
HealthCmd=curl -sf http://localhost:8000/health || exit 1
HealthStartPeriod=30s
HealthInterval=10s
HealthRetries=3
HealthTimeout=5s

[Install]
WantedBy=__PROJECT__.target
