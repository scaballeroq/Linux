    ./Setup/cachyos-repos.sh

# Diagnóstico de los repositorios y espejos de CachyOS
cachyos-repos-status:
    ./Setup/cachyos-repos.sh --status

# Calibra y clasifica los espejos más rápidos con cachyos-rate-mirrors
rate-mirrors:
    ./Setup/cachyos-repos.sh --rate-mirrors

# Post-instalación base con auto-detección de CPU (AMD Ryzen vs Intel Core)
post-install:
    ./Setup/post-install.sh

# Post-instalación específica para AMD Ryzen y gráficos Radeon (Mesa RADV + VA-API)
post-install-amd:
    ./Setup/post-install-amd.sh

# Post-instalación específica para Intel Core
post-install-intel:
    ./Setup/post-install-intel.sh

# Configura Swap en ZRAM (zstd, 50-100% RAM, prioridad 100)
zram:
    ./Setup/zram-setup.sh

# Muestra el estado actual de ZRAM y dispositivos de swap
zram-status:
    ./Setup/zram-setup.sh --status

# Aplica optimizaciones de Kernel (sysctl), Ananicy-CPP, UKSMD y exclusiones de Tracker
tuning:
    ./Setup/cachyos-tuning.sh

# Muestra el diagnóstico de optimización del sistema (sysctl, límites, Tracker)
tuning-status:
    ./Setup/cachyos-tuning.sh --status

# Optimización para portátil (energía, Touchpad Wayland, multimonitor, logind y Bluetooth)
laptop:
    ./Setup/laptop-setup.sh

# Muestra telemetría de batería, CPU EPP y pantallas DRM del portátil
laptop-status:
    ./Setup/laptop-setup.sh --status

# Configura lector de huella dactilar (fprintd + PAM)
fingerprint:
    ./Setup/fingerprint-setup.sh

# Estado del lector de huella dactilar
fingerprint-status:
    ./Setup/fingerprint-setup.sh --status

# Configura impresora HP (CUPS, HPLIP, colas IPP Everywhere y Firewalld)
printer *args:
    ./Setup/hp-printer-setup.sh {{args}}

# Estado del subsistema de impresión HP
printer-status:
    ./Setup/hp-printer-setup.sh --status

# Endurecimiento de red con Firewalld exclusivo, DNS-over-TLS y sysctl
security:
    ./Setup/seguridad.sh

# Habilita puertos de desarrollo local en Firewalld (3000, 5173, 8000, 8080)
security-dev-ports:
    ./Setup/seguridad.sh --dev-ports

# Estado del cortafuegos Firewalld y reglas de seguridad
security-status:
    ./Setup/seguridad.sh --status

# Instala e integra la consola web de administración Cockpit (socket bajo demanda)
