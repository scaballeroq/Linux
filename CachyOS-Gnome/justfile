# ==============================================================================
#  9. MANTENIMIENTO DEL SISTEMA (PACMAN / PARU + FLATPAK + MISE)
# ==============================================================================

# Actualiza todo el sistema CachyOS (Pacman/Paru, Flatpak y Mise)
upgrade:
    @if command -v paru &>/dev/null; then paru -Syu --noconfirm; else sudo pacman -Syu --noconfirm; fi
    flatpak update -y
    ~/.local/bin/mise upgrade || true

# Limpia paquetes huérfanos, caché de Pacman y runtimes Flatpak no utilizados
clean:
    sudo pacman -Rns $(pacman -Qtdq) 2>/dev/null || true
    sudo paccache -r 2>/dev/null || sudo pacman -Sc --noconfirm
    flatpak uninstall --unused -y
