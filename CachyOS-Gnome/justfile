# ==============================================================================
#  Justfile - Orquestador de Configuración para CachyOS Workstation (GNOME Wayland)
#  Gestor de Paquetes: Pacman / Paru + Repositorios CachyOS (x86-64-v3) + Flatpak
# ==============================================================================

set shell := ["bash", "-euo", "pipefail", "-c"]

# Mostrar lista de recetas disponibles por defecto
default:
    @just --list --unsorted

# ==============================================================================
#  1. PERFILES DE DESPLIEGUE COMPLETO
# ==============================================================================

# Ejecuta la instalación completa para estación de trabajo CachyOS Workstation
setup-all: post-install cachyos-repos zram tuning laptop fingerprint printer security fonts shell zsh starship fastfetch kitty ghostty ptyxis apariencia gnome-setup gnome-extensions gsconnect multimedia flatpak chrome firefox steam virtualization podman git mise languages ide
    @echo "✅ Despliegue integral de CachyOS Workstation (GNOME Wayland) completado."

# Perfil optimizado para Portátil de Desarrollo AMD Ryzen (HP ProBook 455 G10)
setup-laptop-amd: post-install-amd cachyos-repos zram tuning laptop fingerprint printer security fonts shell zsh starship fastfetch kitty ghostty ptyxis apariencia gnome-setup gnome-extensions gsconnect multimedia flatpak chrome firefox virtualization podman git mise languages ide
    @echo "✅ Perfil Portátil Desarrollo AMD Ryzen en CachyOS Workstation completado."

# Perfil para Sobremesa / Media Center Intel Core
setup-media-desktop: post-install-intel cachyos-repos zram tuning security fonts shell starship fastfetch kitty apariencia gnome-setup gnome-extensions multimedia flatpak chrome firefox
    @echo "✅ Perfil Sobremesa Multimedia Intel en CachyOS Workstation completado."

# ==============================================================================
#  2. DIAGNÓSTICO GLOBAL (--status)
# ==============================================================================

# Muestra el estado global de todos los componentes de CachyOS Workstation
status:
    ./Setup/post-install-amd.sh --status
    ./Setup/cachyos-repos.sh --status
    ./Setup/zram-setup.sh --status
    ./Setup/cachyos-tuning.sh --status
    ./Setup/laptop-setup.sh --status
    ./Setup/seguridad.sh --status
    ./Setup/apariencia.sh --status
    ./Setup/gnome-settings.sh --status
    ./Setup/gnome-extensions.sh --status
    ./Setup/multimedia.sh --status
    ./Setup/flatpak.sh --status
    ./Podman/install/podman-install.sh --status
    ./Virtualizacion/virtualization.sh --status

