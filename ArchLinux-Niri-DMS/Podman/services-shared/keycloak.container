[Unit]
Description=Keycloak Identity Management
Requires=network-online.target
After=network-online.target

[Container]
ContainerName=keycloak
Image=quay.io/keycloak/keycloak:latest
Exec=start-dev
Environment=KEYCLOAK_ADMIN=admin
Environment=KEYCLOAK_ADMIN_PASSWORD=admin
Environment=KC_DB=postgres
Environment=KC_DB_URL=jdbc:postgresql://postgres-global:5432/keycloak
Environment=KC_DB_USERNAME=postgres
Environment=KC_DB_PASSWORD=postgres
Environment=KC_HOSTNAME=localhost
PublishPort=8081:8080
Network=dev-shared.network

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
