# NixOS Environment Configuration Justfile
# (NixOS + Flakes + KDE Plasma 6 Wayland)

# Instala todo el entorno por defecto (Auto-detección de CPU / Portátil AMD)
setup-all: post-install multimedia flatpak chrome steam laptop tuning kde-setup shell security fonts fastfetch kitty yt-dlp virtualization cockpit ides git-setup languages podman-setup
    @echo "🚀 Entorno completo de NixOS (KDE Plasma 6) configurado. Por favor, reinicia el sistema."

# Perfil completo para Portátil de desarrollo (AMD Ryzen + Virtualización + Contenedores)
setup-laptop-amd: post-install-amd multimedia flatpak chrome steam laptop tuning kde-setup shell security fonts fastfetch kitty yt-dlp virtualization cockpit ides git-setup languages podman-setup
    @echo "🚀 Entorno Portátil AMD Ryzen (KDE Plasma 6) configurado con éxito. Por favor, reinicia el sistema."

# Perfil para Sobremesa Centro Multimedia (Intel Core / Media Center - Sin virtualización ni batería)
setup-media-desktop: post-install-intel multimedia chrome tuning kde-setup shell security fonts fastfetch kitty yt-dlp
    @echo "🚀 Entorno Sobremesa Intel (KDE Plasma 6) configurado con éxito. Por favor, reinicia el sistema."

# =============================================================================
# OPERACIONES DECLARATIVAS DE NIXOS (FLAKES & REBUILD)
# =============================================================================

# Aplica la configuración del host actual en vivo (nixos-rebuild switch)
switch:
    sudo nixos-rebuild switch --flake .#

# Aplica la configuración de un host específico (ej: just switch-host laptop-amd)
switch-host host:
    sudo nixos-rebuild switch --flake .#{{host}}

# Prueba la configuración temporalmente sin agregarla al menú del bootloader
test:
    sudo nixos-rebuild test --flake .#

# Compila y registra la configuración para el próximo arranque (sin aplicar en vivo)
boot:
    sudo nixos-rebuild boot --flake .#

# Actualiza todos los inputs del Flake (nixpkgs, home-manager)
update:
    nix flake update

# Limpieza completa: elimina generaciones antiguas y optimiza /nix/store
clean:
    sudo nix-collect-garbage -d
    nix-collect-garbage -d
    sudo nix-store --optimise

# Lista las generaciones registradas en el perfil de sistema
generations:
    sudo nix-env --list-generations --profile /nix/var/nix/profiles/system

# Revierte a la generación inmediatamente anterior del sistema
rollback:
    sudo nixos-rebuild --rollback switch

