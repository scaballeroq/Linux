# Omarchy Environment Configuration Justfile
# (Arch Linux + Hyprland - Omarchy 4.5 Quattro RS)
# Optimizado para HP ProBook 455 G10 (AMD Ryzen 7 7730U / Radeon Vega 8)

# Muestra ayuda por defecto
default:
    @just --list

# Instala todo el entorno por defecto
setup-all: post-install security fonts bash-setup virtualization mise cockpit ides git-setup languages yt-dlp fastfetch
    @echo "🚀 Entorno completo de Omarchy 4.5 configurado. Por favor, reinicia el sistema."

# =============================================================================
# CONFIGURACIÓN BASE DEL SISTEMA
# =============================================================================

# Configuración base post-instalación (AMD Ryzen/Radeon, ZRAM, Wayland, Codecs)
post-install:
    ./Setup/post-install.sh

# Repositorio precompilado Chaotic-AUR y optimizaciones de Pacman
chaotic-aur:
    ./Setup/chaotic-aur.sh

# Diagnóstico de integración de Chaotic-AUR, repositorios y pacman.conf
chaotic-status:
    ./Setup/chaotic-aur.sh --status

# Refresco e inicialización de firmas digitales (Arch Linux y Chaotic-AUR)
chaotic-keys:
    ./Setup/chaotic-aur.sh --keys

# Actualización completa del sistema sincronizada
chaotic-update:
    ./Setup/chaotic-aur.sh --update

# Seguridad de red y cortafuegos (Firewalld exclusivo)
security:
    ./Setup/seguridad.sh

# Fuentes de desarrollo (Nerd Fonts: JetBrainsMono, FiraCode, CascadiaCode...)
fonts:
    ./Setup/fonts.sh

# Configuración modular de Bash (Aliases, Funciones, Entorno)
bash-setup:
    ./Bash.Setup/setup.sh

# Información estética del sistema (Fastfetch)
fastfetch:
    ./Setup/fastfetch.sh

# Multimedia (yt-dlp, ffmpeg)
yt-dlp:
    ./Setup/yt-dlp-setup.sh

# =============================================================================
# CONFIGURACIÓN DE RED Y VIRTUALIZACIÓN
# =============================================================================

# Configuración de KVM/QEMU y Libvirt
virtualization:
    ./Virtualizacion/virtualization.sh

# Administración Web (Cockpit)
cockpit:
    ./Setup/cockpit.sh

# =============================================================================
# CONTROL DE VERSIONES
# =============================================================================

# Git, Delta, Lazygit, GH CLI
git-setup:
    ./Git/git.sh
    ./Git/github-cli.sh

# =============================================================================
# GESTORES DE RUNTIMES
# =============================================================================

# Gestor de versiones Mise
mise:
    ./ProgrammingLanguages/mise.sh

# =============================================================================
# LENGUAJES DE PROGRAMACIÓN
# =============================================================================

# Todos los lenguajes
languages: node python rust dotnet java
    @echo "✅ Lenguajes instalados."

# Diagnóstico de estado de lenguajes y runtimes
lang-status:
    ./ProgrammingLanguages/mise.sh --status
    ./ProgrammingLanguages/python.sh --status
    ./ProgrammingLanguages/nodejs.sh --status
    ./ProgrammingLanguages/java.sh --status
    ./ProgrammingLanguages/rust.sh --status

# Node.js LTS
node:
    ./ProgrammingLanguages/nodejs.sh

# Python & uv
python:
    ./ProgrammingLanguages/python.sh

# Rust
rust:
    ./ProgrammingLanguages/rust.sh

# .NET SDK
dotnet:
    ./ProgrammingLanguages/dotnet.sh

# Java (OpenJDK)
java:
    ./ProgrammingLanguages/java.sh

# =============================================================================
# HERRAMIENTAS DE IA
# =============================================================================

# Gemini CLI
gemini:
    ./ProgrammingLanguages/gemini.sh

# Angular CLI
angular:
    ./ProgrammingLanguages/angular.sh

# Antigravity CLI
antigravity-ai:
    ./IDE/antigravity-cli.sh

# =============================================================================
# ENTORNOS DE DESARROLLO (IDEs)
# =============================================================================

# Todos los IDEs
ides: nvim vscode antigravity antigravity-cli antigravity-ide opencode
    @echo "✅ IDEs instalados."

# Diagnóstico de estado de la suite de IDEs
ide-status:
    ./IDE/antigravity.sh --status
    ./IDE/antigravity-cli.sh --status
    ./IDE/antigravity-ide.sh --status
    ./IDE/opencode.sh --status

# Neovim + LazyVim (Wayland nativo)
nvim:
    ./IDE/neovim.sh

# Visual Studio Code (Wayland nativo)
vscode:
    ./IDE/vscode.sh

# Google Antigravity Desktop 2.0 (Completo)
antigravity:
    ./IDE/antigravity.sh

# Google Antigravity CLI
antigravity-cli:
    ./IDE/antigravity-cli.sh

# Google Antigravity IDE Engine
antigravity-ide:
    ./IDE/antigravity-ide.sh

# OpenCode AI CLI/Editor
opencode:
    ./IDE/opencode.sh

# =============================================================================
# JUEGOS
# =============================================================================

# Steam y herramientas de juegos (Vulkan RADV, GameMode, MangoHud)
steam:
    ./Juegos/steam.sh

# =============================================================================
# DOCKER & LAZYDOCKER
# =============================================================================

# Configuración y permisos de Docker y Lazydocker (preinstalados en Omarchy)
docker-setup:
    ./Docker/install/docker-setup.sh

# Configuración personalizada de Lazydocker
lazydocker-setup:
    ./Docker/install/lazydocker-setup.sh

# Iniciar servicios globales compartidos (Traefik, Keycloak, PostgreSQL, Redis)
docker-shared-up:
    ./Docker/lib/docker-utils.sh shared up

# Detener servicios globales compartidos
docker-shared-down:
    ./Docker/lib/docker-utils.sh shared down

# Ver logs de servicios globales compartidos
docker-shared-logs:
    ./Docker/lib/docker-utils.sh shared logs

# Ver estado de servicios globales compartidos
docker-shared-status:
    ./Docker/lib/docker-utils.sh shared status

# Limpieza completa de contenedores, imágenes huérfanas y volúmenes de Docker
docker-clean:
    docker system prune -af --volumes

# Abrir Lazydocker (interfaz gráfica TUI)
lazydocker:
    lazydocker

# Alias rápido para Lazydocker
lzd:
    lazydocker

# =============================================================================
# TELEMETRÍA Y CONTROL DE HARDWARE (HP ProBook 455 G10)
# =============================================================================

# Diagnóstico de hardware, cortafuegos, pantallas y memoria ZRAM
status:
    @echo "================================================================="
    @echo "💻 TELEMETRÍA: HP ProBook 455 G10 (Omarchy 4.5)"
    @echo "================================================================="
    @echo "🔹 CPU:       $$(lscpu | grep 'Model name:' | sed 's/Model name:[ \t]*//')"
    @echo "🔹 GPU:       $$(lspci | grep -i 'vga\|3d' | cut -d: -f3)"
    @echo "🔹 Kernel:    $$(uname -r)"
    @echo "🔹 Wayland:   $$XDG_SESSION_TYPE ($$WAYLAND_DISPLAY)"
    @echo "🔹 Firewalld: $$(sudo firewall-cmd --state 2>/dev/null || echo 'inactivo')"
    @echo "🔹 ZRAM Swap: $$(swapon --show | grep -E 'zram|Type' || echo 'Sin ZRAM')"
    @echo "🔹 Audio:     $$(wpctl status 2>/dev/null | grep -E 'Default|Sink' | head -n2 || echo 'PipeWire OK')"
    @echo "================================================================="

# Consulta de topología de monitores en Hyprland
monitors:
    @command -v hyprctl >/dev/null 2>&1 && hyprctl monitors || echo "⚠️ hyprctl no disponible fuera de sesión Hyprland"
