[Unit]
Description=Backend Python para __PROJECT__
PartOf=__PROJECT__.target
After=__PROJECT__-network.service __PROJECT__-postgres.service __PROJECT__-redis.service
Requires=__PROJECT__-postgres.service __PROJECT__-redis.service

[Container]
ContainerName=__PROJECT__-backend
Image=docker.io/library/python:3.13-slim
EnvironmentFile=__PROJECT_DIR__/.env
Network=__PROJECT__.network
Volume=__PROJECT_DIR__/src:/app:z
Volume=__PROJECT_DIR__/requirements.txt:/app/requirements.txt:ro,z
WorkingDir=/app
Exec=sh -c "pip install --no-cache-dir -r requirements.txt && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
PublishPort=8000:8000
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
HealthStartPeriod=30s
HealthInterval=10s
HealthRetries=3
HealthTimeout=5s

[Install]
WantedBy=__PROJECT__.target
