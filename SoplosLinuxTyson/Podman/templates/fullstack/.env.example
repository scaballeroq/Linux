# =============================================================================
# Configuración de Entorno - __PROJECT__ (Fullstack)
# =============================================================================

PROJECT_NAME=__PROJECT__
ENVIRONMENT=development
DEBUG=True

# Base de Datos PostgreSQL
POSTGRES_DB=__PROJECT__
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_HOST=__PROJECT__-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password_change_me@__PROJECT__-postgres:5432/__PROJECT__

# Keycloak Auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password_123
KC_DB=postgres
KC_DB_URL_HOST=__PROJECT__-postgres
KC_DB_URL_DATABASE=__PROJECT__
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=postgres_dev_password_change_me
KC_HOSTNAME=auth.__PROJECT__.localhost
KC_HOSTNAME_PORT=80
KC_HOSTNAME_STRICT=false
KC_HTTP_RELATIVE_PATH=/auth
KC_PROXY_HEADERS=xforwarded

# Proveedores OAuth (Opcional - Configura tus credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend & Backend
PORT=8000
HOST=0.0.0.0
VITE_API_URL=http://api.__PROJECT__.localhost
VITE_AUTH_URL=http://auth.__PROJECT__.localhost/auth
SECRET_KEY=dev-secret-key-change-in-production-fullstack-123456789
