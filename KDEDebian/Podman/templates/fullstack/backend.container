[Unit]
Description=Backend Python para __PROJECT__
After=__PROJECT__.network __PROJECT__-postgres.service
Requires=__PROJECT__-postgres.service

[Container]
ContainerName=__PROJECT__-backend
Image=docker.io/library/python:3.13-slim
EnvironmentFile=__PROJECT_DIR__/.env
Network=__PROJECT__.network
Volume=__PROJECT_DIR__/src:/app:z
Volume=__PROJECT_DIR__/requirements.txt:/app/requirements.txt:ro,z
WorkingDir=/app
Command=sh -c "pip install --no-cache-dir -r requirements.txt && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
Label=traefik.enable=true
Label=traefik.http.routers.__PROJECT__-backend.rule=Host(`api.__PROJECT__.localhost`)
Label=traefik.http.routers.__PROJECT__-backend.entrypoints=web
Label=traefik.http.routers.__PROJECT__-backend.service=__PROJECT__-backend
Label=traefik.http.services.__PROJECT__-backend.loadbalancer.server.port=8000
HealthCmd=curl -sf http://localhost:8000/health || exit 1
HealthStartPeriod=30s
HealthInterval=10s
HealthRetries=3
HealthTimeout=5s

[Install]
WantedBy=__PROJECT__.target
