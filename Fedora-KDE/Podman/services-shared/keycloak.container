[Unit]
Description=Keycloak Auth Global
After=podman-network-proxy-net.service

[Container]
ContainerName=keycloak
Image=quay.io/keycloak/keycloak:26
Network=proxy-net
Environment=KEYCLOAK_ADMIN=admin
Environment=KEYCLOAK_ADMIN_PASSWORD=admin
Environment=KC_DB=postgres
Environment=KC_DB_URL_HOST=postgres-global
Environment=KC_DB_URL_DATABASE=keycloak
Environment=KC_DB_USERNAME=postgres
Environment=KC_DB_PASSWORD=changeme_dev_123
Environment=KC_HOSTNAME=localhost
Environment=KC_HOSTNAME_PORT=8083
Environment=KC_HOSTNAME_STRICT=false
Environment=KC_PROXY=edge
PublishPort=8083:8080
Command=start-dev --http-relative-path=/auth
Label=traefik.enable=true
Label=traefik.http.routers.keycloak.rule=Host(`auth.localhost`)
Label=traefik.http.routers.keycloak.entrypoints=web
Label=traefik.http.routers.keycloak.service=keycloak
Label=traefik.http.services.keycloak.loadbalancer.server.port=8080
HealthCmd=curl -sf http://localhost:8080/auth/health/ready || exit 1
HealthStartPeriod=60s
HealthInterval=10s
HealthRetries=10
HealthTimeout=5s

[Install]
WantedBy=default.target
