# ProgrammingLanguages Sub-Justfile - Fedora 44 (KDE Plasma 6)

# Instalar todos los lenguajes y runtimes
languages: mise node python rust dotnet java angular
    @echo "✅ Todos los lenguajes han sido instalados correctamente."

# Mise version manager
mise:
    ./mise.sh

# Node.js LTS
node:
    ./nodejs.sh

# Python & uv
python:
    ./python.sh

# Creador de proyectos Python aislados con uv
python-uv:
    ./python-uv-init.sh

# Rust toolchain & cargo-binstall
rust:
    @[ -f ./rust.sh ] && ./rust.sh || ./Revisar/rust.sh

# .NET SDK LTS
dotnet:
    @[ -f ./dotnet.sh ] && ./dotnet.sh || ./Revisar/dotnet.sh

# OpenJDK Java LTS
java:
    ./java.sh

# Angular CLI
angular:
    @[ -f ./angular.sh ] && ./angular.sh || ./Revisar/angular.sh
